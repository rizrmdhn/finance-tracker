{
	"name": "finance-tracker",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@trpc/tanstack-react-query": "^11.25.0",
			"@trpc/client": "^11.25.0",
			"@trpc/server": "^11.25.0",
			"drizzle-orm": "^0.45.4",
			"drizzle-kit": "^0.31.11",
			"date-fns": "^4.4.0",
			"better-sqlite3": "^13.0.3",
			"dotenv": "^17.4.2",
			"dotenv-cli": "^11.1.0",
			"zod": "^4.6.7",
			"lucide-react": "^0.577.0",
			"next-themes": "^0.4.6",
			"sonner": "^2.0.8",
			"react": "19.3.0",
			"react-dom": "19.3.0",
			"react-day-picker": "^9.14.0",
			"recharts": "2.15.4",
			"superjson": "^2.2.6",
			"@types/react": "^19.3.0",
			"@types/react-dom": "^19.3.0",
			"@types/better-sqlite3": "^7.6.13",
			"tailwindcss": "^4.3.5",
			"tailwind-merge": "^3.7.0",
			"expo-sqlite": "~55.0.11",
			"@paralleldrive/cuid2": "^3.3.0",
			"@tanstack/react-query": "^5.107.1",
			"@tanstack/react-router": "^1.170.46",
			"@tanstack/react-router-devtools": "^1.167.2",
			"@tanstack/react-table": "^8.21.3",
			"@tanstack/router-plugin": "^1.168.48",
			"@tailwindcss/vite": "^4.3.5",
			"@hookform/resolvers": "^5.9.2",
			"@types/node": "^22.20.5",
			"typescript": "^6.0.3",
			"react-hook-form": "^7.91.0",
			"class-variance-authority": "^0.7.1",
			"clsx": "^2.1.1",
			"i18next": "^25.10.10"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"lint": "biome check .",
		"check-types": "turbo check-types",
		"dev:native": "turbo -F @finance-tracker/native dev",
		"dev:android": "cd apps/native && expo run:android",
		"dev:web": "turbo -F @finance-tracker/web dev",
		"dev:desktop": "turbo -F @finance-tracker/desktop dev",
		"dev:desktop-web": "turbo -F @finance-tracker/web -F @finance-tracker/desktop dev",
		"desktop:build": "turbo -F @finance-tracker/desktop build",
		"desktop:pack": "turbo -F @finance-tracker/desktop package",
		"db:studio": "turbo -F @finance-tracker/db db:studio",
		"db:migrate": "turbo -F @finance-tracker/db db:migrate",
		"db:generate": "turbo -F @finance-tracker/db db:generate && turbo -F @finance-tracker/native db:generate",
		"check": "biome check --write .",
		"native:doctor": "turbo -F @finance-tracker/native doctor",
		"native:prebuild": "turbo -F @finance-tracker/native prebuild",
		"native:bump": "node apps/native/scripts/bump-version.mjs",
		"tag": "bun scripts/tag.ts",
		"release": "bun scripts/release.ts"
	},
	"dependencies": {
		"@finance-tracker/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@finance-tracker/config": "workspace:*",
		"turbo": "^2.11.10",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.9",
	"overrides": {
		"glob": "^9.0.0",
		"commander": "^7.2.0"
	},
	"patchedDependencies": {
		"electron-updater@6.8.3": "patches/electron-updater@6.8.3.patch",
		"@vlcn.io/crsqlite@0.16.3": "patches/@vlcn.io+crsqlite@0.16.3.patch"
	},
	"trustedDependencies": [
		"@shopify/react-native-skia",
		"@vlcn.io/crsqlite",
		"electron",
		"electron-winstaller",
		"esbuild",
		"msw"
	]
}
